# Configuration de production. Sur le serveur : copier en .env.production et remplir.
# Ce fichier contient des secrets : ne jamais le committer (.env* est ignoré par Git).
#
# Générer chaque secret avec :
#   openssl rand -base64 32

# --- Site ---------------------------------------------------------------------
SITE_URL="https://ioamra-monchau.fr"

# --- Base de données du site ----------------------------------------------------
POSTGRES_USER="portfolio"
POSTGRES_PASSWORD=""

# --- Authentification de l'admin --------------------------------------------------
BETTER_AUTH_SECRET=""

# --- E-mails (Brevo) ----------------------------------------------------------------
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Portfolio <no-reply@ioamra-monchau.fr>"
# Adresse qui reçoit les messages du formulaire de contact
MAIL_TO="moi@example.com"

# --- Statistiques (Umami) ------------------------------------------------------------
UMAMI_DB_PASSWORD=""
UMAMI_APP_SECRET=""
# À remplir après avoir créé le site dans Umami (étape 9 du guide) :
UMAMI_SCRIPT_URL=""
UMAMI_WEBSITE_ID=""

# --- Tunnel Cloudflare ------------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=""
