// Modèle de données du portfolio.
// Conventions : modèles en PascalCase côté TypeScript, tables et colonnes en snake_case côté PostgreSQL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SkillCategory {
  BACKEND
  FRONTEND
  DATABASE
  DEVOPS
  TOOLS
}

enum ProjectKind {
  PROFESSIONAL
  PERSONAL
  ACADEMIC
}

enum ExperienceType {
  WORK
  EDUCATION
}

/// Informations du propriétaire du site. Une seule ligne (id = 1).
model Profile {
  id           Int      @id @default(1)
  fullName     String   @map("full_name") @db.VarChar(100)
  headline     String   @db.VarChar(150)
  bio          String
  location     String?  @db.VarChar(100)
  /// Texte libre affiché en accueil, ex. « Disponible immédiatement ». Null = masqué.
  availability String?  @db.VarChar(150)
  githubUrl    String?  @map("github_url") @db.VarChar(255)
  /// Chemin du CV PDF dans le stockage de fichiers.
  cvPath       String?  @map("cv_path") @db.VarChar(255)
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("profile")
}

model Skill {
  id          String        @id @default(cuid())
  name        String        @unique @db.VarChar(50)
  category    SkillCategory
  /// Ordre d'affichage au sein de la catégorie.
  position    Int           @default(0)
  projects    Project[]
  experiences Experience[]
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([category, position])
  @@map("skills")
}

model Project {
  id        String         @id @default(cuid())
  slug      String         @unique @db.VarChar(100)
  title     String         @db.VarChar(100)
  /// Accroche courte, affichée dans les cartes.
  summary   String         @db.VarChar(300)
  /// Contenu détaillé en Markdown.
  content   String
  kind      ProjectKind
  repoUrl   String?        @map("repo_url") @db.VarChar(255)
  demoUrl   String?        @map("demo_url") @db.VarChar(255)
  /// Mis en avant sur la page d'accueil.
  featured  Boolean        @default(false)
  /// Visible sur le site public.
  published Boolean        @default(false)
  /// Ordre d'affichage (croissant).
  position  Int            @default(0)
  skills    Skill[]
  images    ProjectImage[]
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@index([published, position])
  @@map("projects")
}

model ProjectImage {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Chemin du fichier dans le stockage.
  path      String  @db.VarChar(255)
  alt       String  @db.VarChar(200)
  /// 0 = image de couverture.
  position  Int     @default(0)

  @@index([projectId, position])
  @@map("project_images")
}

model Experience {
  id           String         @id @default(cuid())
  type         ExperienceType
  /// Intitulé du poste ou du diplôme.
  title        String         @db.VarChar(150)
  /// Entreprise ou établissement.
  organization String         @db.VarChar(150)
  location     String?        @db.VarChar(100)
  startDate    DateTime       @map("start_date") @db.Date
  /// Null = en cours.
  endDate      DateTime?      @map("end_date") @db.Date
  description  String
  skills       Skill[]
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@index([type, startDate(sort: Desc)])
  @@map("experiences")
}

model ContactMessage {
  id        String    @id @default(cuid())
  name      String    @db.VarChar(100)
  email     String    @db.VarChar(254)
  subject   String    @db.VarChar(150)
  message   String
  /// Null = non lu.
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@map("contact_messages")
}
