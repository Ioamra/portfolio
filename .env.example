# Copier ce fichier en .env et adapter les valeurs.

# Base de données (docker-compose : service "db")
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5434/portfolio"

# SMTP (dev : Mailpit, prod : Brevo)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Portfolio <no-reply@localhost>"
# Adresse qui reçoit les messages du formulaire de contact
MAIL_TO="moi@example.com"

# Dossier des fichiers uploadés (CV, images), relatif au dossier de lancement
STORAGE_DIR="storage"

# Authentification (Better Auth)
# Secret de chiffrement des sessions : générer avec
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
# URL publique du site (liens absolus, SEO, authentification)
SITE_URL="http://localhost:3000"
